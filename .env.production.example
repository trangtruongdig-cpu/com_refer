# ============================================================
#  Môi trường PRODUCTION — copy thành .env TRÊN VPS (không commit!)
#  Tạo secret mạnh: openssl rand -base64 48
# ============================================================

NODE_ENV=production

# --- Domain (đã trỏ DNS bản ghi A về IP VPS) ---
# Mặc định 1 domain: frontend ở https://DOMAIN_APP, API ở https://DOMAIN_APP/api
DOMAIN_APP=app.example.com
# Chỉ dùng khi tách API ra domain riêng (xem caddy/sites/api.caddy.example)
DOMAIN_API=
# Email nhận thông báo từ Let's Encrypt
ACME_EMAIL=you@example.com

# --- Image trên GHCR ---
# GitHub Actions tự ghi 2 biến này mỗi lần deploy (ghcr.io/<user>/<repo> viết thường,
# TAG = commit SHA). Chỉ cần sửa tay khi chạy compose thủ công / rollback.
IMAGE_PREFIX=ghcr.io/your-github-user/your-repo
TAG=latest

# --- PostgreSQL ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=app_db
# Nếu mật khẩu có ký tự đặc biệt (@ : / ? # %) thì phải URL-encode trong DATABASE_URL
DATABASE_URL=postgresql://app_user:CHANGE_ME_openssl_rand_base64_32@postgres:5432/app_db?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_another_openssl_rand_base64_48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Backend ---
# Chỉ cho phép domain frontend (nhiều domain cách nhau bằng dấu phẩy)
CORS_ORIGIN=https://app.example.com
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Số proxy đứng trước backend (Caddy = 1)
TRUST_PROXY=1

# --- Tài khoản admin được seed (đổi mật khẩu sau lần đăng nhập đầu) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- Backup ---
TZ=Asia/Ho_Chi_Minh
BACKUP_RETENTION=7
# (Tùy chọn) đẩy backup lên S3 / R2 / Backblaze bằng rclone, ví dụ: r2:my-bucket/db
RCLONE_REMOTE=

# --- Monitoring (tùy chọn, profile "monitoring") ---
DOMAIN_LOGS=logs.example.com
DOMAIN_STATUS=status.example.com
MONITOR_USER=admin
# Tạo hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mat-khau'
# Lưu ý: đặt hash trong dấu nháy ĐƠN để compose không hiểu ký tự $ là biến
#   MONITOR_PASSWORD_HASH='$2a$14$....'
MONITOR_PASSWORD_HASH=
