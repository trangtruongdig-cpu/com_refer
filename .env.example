# ============================================================
#  Môi trường DEV — copy thành .env (không bắt buộc: docker-compose.yml
#  đã có giá trị mặc định cho mọi biến dưới đây)
# ============================================================

NODE_ENV=development

# --- Domain (chỉ dùng ở production, để đây cho đủ bộ biến) ---
DOMAIN_APP=localhost
DOMAIN_API=localhost
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432
# Host "postgres" là tên service trong docker compose.
# Nếu chạy backend trực tiếp trên máy (không qua Docker) thì đổi thành localhost.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_db?schema=public

# --- JWT (tạo secret mạnh: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Backend ---
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- Tài khoản admin được seed ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api
# Nguồn dữ liệu của module tuyển sinh: demo = localStorage, api = gọi backend
VITE_TUYENSINH_NGUON=demo
# Tiền tố của module tuyển sinh trên backend, sau /api
VITE_TUYENSINH_TIEN_TO=/tuyensinh

# --- pgAdmin (profile "tools") ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Image tag (dùng ở production) ---
TAG=latest
